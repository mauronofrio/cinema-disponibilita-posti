# Miscellaneous
/.claude/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Built APKs kept for manual installs, not versioned source.
/releases/

# Reverse-engineering research artifacts (decompiled APK, saved web pages,
# raw API samples) - kept on disk as reference/test fixtures, not versioned.
/research/
/UciCinema/
/RedCarpet/
/Galleria/

# Local-only project notes, not meant to be shared/versioned.
/PROJECT_NOTES.md

# External research dataset (~1400 Italian cinemas from OSM, produced by a
# separate research session) - used to cross-check coverage gaps, not a
# project source file.
/cinema_italia.json

# Local, machine-specific Claude Code permission settings.
/.claude/settings.local.json

# Release signing key and its passwords - never committed, back these up
# somewhere safe outside git (losing them means never updating the app
# in place under the same signature again).
/android/key.properties
/android/*.keystore
/android/*.jks

# Report degli audit interni: note di lavoro, non parte del progetto.
.audit-fixes/
